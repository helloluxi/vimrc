# ripgreprc — default flags for `rg`
# Loaded because $RIPGREP_CONFIG_PATH points to ~/.ripgreprc (symlink → here).

--smart-case
--hidden
--follow
--max-columns=200
--max-columns-preview

# directories to skip everywhere
--glob=!.git/
--glob=!node_modules/
--glob=!.venv/
--glob=!__pycache__/
--glob=!.mypy_cache/
--glob=!.pytest_cache/
--glob=!dist/
--glob=!build/
--glob=!target/
--glob=!*.pyc
